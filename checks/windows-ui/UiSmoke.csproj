<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>Program</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../../windows/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../windows/PetApp.cs" Link="PetApp.cs" />
    <Compile Include="../../windows/Usage.cs" Link="Usage.cs" />
    <Compile Include="../../windows/PetUsageFeatures.cs" Link="PetUsageFeatures.cs" />
    <Compile Include="../../windows/UsagePolicy.cs" Link="UsagePolicy.cs" />
    <Compile Include="../../windows/WindowsFeatures.cs" Link="WindowsFeatures.cs" />
    <Compile Include="../../windows/UsageCredentials.cs" Link="UsageCredentials.cs" />
    <Compile Include="../../windows/UsageSnapshots.cs" Link="UsageSnapshots.cs" />
    <Compile Include="../../windows/UsageHistory.cs" Link="UsageHistory.cs" />
    <Compile Include="../../windows/Language.cs" Link="Language.cs" />
    <Compile Include="../../windows/Settings.cs" Link="Settings.cs" />
    <Compile Include="../../windows/UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <Compile Include="../../windows/UpdateApply.cs" Link="UpdateApply.cs" />
    <Compile Include="../../windows/PortableUpdate.cs" Link="PortableUpdate.cs" />
    <Compile Include="../../windows/Updates.cs" Link="Updates.cs" />
    <EmbeddedResource Include="../../UPDATE_PUBLIC_KEY" LogicalName="UPDATE_PUBLIC_KEY" />
    <Resource Include="../../assets/*.png" Link="Sprites/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
