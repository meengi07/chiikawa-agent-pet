<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ChiikawaPet.Updater</AssemblyName>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UpdateProtocol.cs" Link="UpdateProtocol.cs" />
    <Compile Include="../UpdateApply.cs" Link="UpdateApply.cs" />
    <Compile Include="../PortableUpdate.cs" Link="PortableUpdate.cs" />
    <EmbeddedResource Include="../../UPDATE_PUBLIC_KEY" LogicalName="UPDATE_PUBLIC_KEY" />
  </ItemGroup>
</Project>
